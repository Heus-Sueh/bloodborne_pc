{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Ninja Build",
      "description": "Default RelWithDebInfo build using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Debug build with symbols and debug asserts enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Optimized release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Build All",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    },
    {
      "name": "lint",
      "displayName": "Lint Codebase",
      "configurePreset": "default",
      "targets": ["lint"]
    },
    {
      "name": "format",
      "displayName": "Format Codebase",
      "configurePreset": "default",
      "targets": ["format"]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "Run Tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
