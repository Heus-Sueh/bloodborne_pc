<rml>
<head>
    <title>Bloodborne PC Launcher</title>
    <link type="text/rcss" href="style.rcss" />
</head>
<body data-model="launcher">
    <!-- SIDEBAR NAVIGATION -->
    <div id="sidebar">
        <div class="brand">
            <div class="brand-title">BLOODBORNE</div>
            <div class="brand-subtitle">NATIVE PC PORT</div>
            <div class="brand-divider"></div>
        </div>

        <div class="nav-menu">
            <button class="nav-item" data-class-active="active_tab == 'play'" data-event-click="set_tab('play')">
                {{ tr_tab_play }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'graphics'" data-event-click="set_tab('graphics')">
                {{ tr_tab_graphics }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'effects'" data-event-click="set_tab('effects')">
                {{ tr_tab_effects }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'controls'" data-event-click="set_tab('controls')">
                {{ tr_tab_controls }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'mods'" data-event-click="set_tab('mods')">
                {{ tr_tab_mods }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'trophies'" data-event-click="set_tab('trophies')">
                {{ tr_tab_trophies }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'online'" data-event-click="set_tab('online')">
                {{ tr_tab_online }}
            </button>
            <button class="nav-item" data-class-active="active_tab == 'log'" data-event-click="set_tab('log')">
                {{ tr_tab_log }}
            </button>
        </div>

        <div class="sidebar-footer">
            <div class="lang-selector">
                <span class="lang-label">Lang:</span>
                <button class="lang-btn" data-class-active="ui_language == 'en'" data-event-click="set_language('en')">EN</button>
                <button class="lang-btn" data-class-active="ui_language == 'pt_BR'" data-event-click="set_language('pt_BR')">PT</button>
                <button class="lang-btn" data-class-active="ui_language == 'ru'" data-event-click="set_language('ru')">RU</button>
                <button class="lang-btn" data-class-active="ui_language == 'zh_CN'" data-event-click="set_language('zh_CN')">ZH</button>
                <button class="lang-btn" data-class-active="ui_language == 'fr_FR'" data-event-click="set_language('fr_FR')">FR</button>
            </div>
        </div>
    </div>

    <!-- MAIN VIEWPORT -->
    <div id="content">

        <!-- TAB: PLAY / THE HUNT -->
        <div class="tab-pane" data-if="active_tab == 'play'">
            <!-- TOP SECTION: HERO BANNER & CHRONICLES CARD (RUSTY MCLA REFERENCE) -->
            <div class="dashboard-top">
                <div class="hero-card">
                    <div class="hero-art-bg">
                        <div class="hero-badge">THE HUNTER'S DREAM</div>
                        <div class="hero-title">YHARNAM CALLS</div>
                        <div class="hero-quote">&#8220;Farewell, good hunter. May you find your worth in the waking world.&#8221;</div>
                    </div>

                    <div class="hero-action-bar">
                        <button class="hero-play-btn" data-if="!is_game_running" data-event-click="play">
                            {{ tr_launch_game }} &#9654;
                        </button>
                        <button class="hero-stop-btn" data-if="is_game_running" data-event-click="stop_game">
                            {{ tr_stop_game }} &#9632;
                        </button>
                        <div class="hero-status-block">
                            <div class="hero-status-tag" data-class-warn="is_update_needed">
                                <span data-if="!is_game_running &amp;&amp; is_valid">AWAKENED &amp; READY</span>
                                <span data-if="!is_game_running &amp;&amp; is_update_needed">UPDATE 1.09 REQUIRED</span>
                                <span data-if="!is_game_running &amp;&amp; !is_valid &amp;&amp; !is_update_needed">GAME DATA NOT FOUND</span>
                                <span data-if="is_game_running">HUNTING IN YHARNAM</span>
                            </div>
                            <div class="hero-status-desc">
                                Bloodborne PC v{{ game_version }} &bull; {{ game_title_id }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="notes-card">
                    <div class="card-label">CHRONICLES &amp; NOTES</div>
                    <div class="notes-title">Release Notes</div>
                    <div class="notes-ver-tag">
                        <span class="badge-ver">v0.7.0</span>
                        <span class="badge-tag">LATEST</span>
                        <span class="badge-date">Linux Native</span>
                    </div>
                    <div class="notes-body">
                        <div class="note-bullet">&bull; FSR 3.1 &amp; Temporal Upscaling integration</div>
                        <div class="note-bullet">&bull; Uncapped framerate support (60+ FPS)</div>
                        <div class="note-bullet">&bull; Dynamic Shadows, SSR &amp; SSAO pipeline</div>
                        <div class="note-bullet">&bull; Native SDL3 low-latency audio engine</div>
                        <div class="note-bullet">&bull; Trophy XML parser &amp; local achievement tracker</div>
                        <div class="note-bullet">&bull; Seamless co-op server &amp; P2P matchmaking</div>
                    </div>
                </div>
            </div>

            <!-- 4 MODULAR UTILITY CARDS GRID (RUSTY MCLA REFERENCE) -->
            <div class="utility-grid">
                <!-- CARD 1: THE ARCHIVES (INSTALL) -->
                <div class="util-card">
                    <div class="card-label">THE ARCHIVES</div>
                    <div class="util-status">
                        <span class="status-check" data-if="is_valid">&#10003;</span>
                        <span class="status-text" data-if="is_valid">Data Linked</span>
                        <span class="status-text" data-if="!is_valid">Unlinked</span>
                    </div>
                    <div class="util-detail">{{ game_dir }}</div>
                    <div class="util-sub">Disc image verified &bull; 29.8 GB</div>
                    <div class="util-actions">
                        <button class="btn-micro" data-event-click="choose_game_dir">LOCATE</button>
                        <button class="btn-micro" data-event-click="extract_dump">EXTRACT</button>
                    </div>
                </div>

                <!-- CARD 2: SAVED MEMORIES (SAVES) -->
                <div class="util-card">
                    <div class="card-label">SAVED MEMORIES</div>
                    <div class="util-status">
                        <span class="status-check">&#10003;</span>
                        <span class="status-text">Save Active</span>
                    </div>
                    <div class="util-detail">{{ user_dir }}</div>
                    <div class="util-sub">Profile: savedata_00.bin</div>
                    <div class="util-actions">
                        <button class="btn-micro" data-event-click="choose_user_dir">BACKUP</button>
                        <button class="btn-micro" data-event-click="choose_user_dir">FOLDER</button>
                    </div>
                </div>

                <!-- CARD 3: CHALICE &amp; MODS (MODS) -->
                <div class="util-card">
                    <div class="card-label">CHALICE &amp; MODS</div>
                    <div class="util-status">
                        <span class="status-check">&#10003;</span>
                        <span class="status-text">Engine Ready</span>
                    </div>
                    <div class="util-detail">{{ mods_dir }}</div>
                    <div class="util-sub">Patches &amp; FSR enabled</div>
                    <div class="util-actions">
                        <button class="btn-micro" data-event-click="set_tab('mods')">MANAGE</button>
                    </div>
                </div>

                <!-- CARD 4: WORKSHOP DIAGNOSTICS (LOGS & BUG REPORT) -->
                <div class="util-card last">
                    <div class="card-label">WORKSHOP DIAGNOSTICS</div>
                    <div class="util-status">
                        <span class="status-text">Something wrong?</span>
                    </div>
                    <div class="util-sub">Export Hunter's logs for issues.</div>
                    <div class="util-actions">
                        <button class="btn-micro btn-red" data-event-click="set_tab('log')">EXPORT LOGS</button>
                        <button class="btn-micro" data-event-click="set_tab('log')">CONSOLE</button>
                    </div>
                </div>
            </div>

            <!-- EXTRACTION PROGRESS -->
            <div class="card extract-card" data-if="is_extracting">
                <div class="extract-header">
                    <span class="extract-label">EXTRACTING GAME ASSETS</span>
                    <span class="extract-pct">{{ extract_progress_pct }}%</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" data-style-width="extract_progress_pct + '%'"></div>
                </div>
                <div class="extract-status">{{ extract_progress_text }}</div>
            </div>

            <!-- PATH CONFIGURATION -->
            <div class="card">
                <div class="card-title">DIRECTORY PATHS &amp; PACKAGES</div>
                <div class="form-group">
                    <label>Game Directory (eboot.bin &amp; dvdroot_ps4)</label>
                    <div class="input-row">
                        <input type="text" class="text-input" data-value="game_dir" readonly="true" />
                        <button class="btn-action" data-event-click="choose_game_dir">BROWSE</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>User Data &amp; Saves Directory</label>
                    <div class="input-row">
                        <input type="text" class="text-input" data-value="user_dir" readonly="true" />
                        <button class="btn-action" data-event-click="choose_user_dir">BROWSE</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Mods Directory</label>
                    <div class="input-row">
                        <input type="text" class="text-input" data-value="mods_dir" readonly="true" />
                        <button class="btn-action" data-event-click="choose_mods_dir">BROWSE</button>
                    </div>
                </div>

                <div class="button-row">
                    <button class="btn-secondary" data-event-click="extract_dump">EXTRACT PKG / DUMP</button>
                    <button class="btn-secondary" data-event-click="install_update">INSTALL UPDATE 1.09</button>
                </div>
            </div>

            <div class="card">
                <div class="card-title">IN-GAME LANGUAGE &amp; STARTUP</div>
                <div class="form-group">
                    <label>In-Game Text Language</label>
                    <input type="text" class="text-input" data-value="game_text_language" data-event-change="save" />
                </div>
                <div class="form-group">
                    <label>In-Game Voice Language</label>
                    <input type="text" class="text-input" data-value="game_voice_language" data-event-change="save" />
                </div>
                <div class="toggle-row">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="skip_network_choice" data-event-change="save" />
                        Skip Startup Network Selection Prompt
                    </label>
                </div>
            </div>
        </div>

        <!-- TAB: GRAPHICS & DISPLAY -->
        <div class="tab-pane" data-if="active_tab == 'graphics'">
            <div class="pane-header">
                <h2>DISPLAY &amp; GRAPHICS</h2>
                <p class="pane-desc">Resolution scaling, refresh rate limits, and Vulkan presentation parameters.</p>
            </div>

            <div class="card">
                <div class="card-title">DISPLAY MODE &amp; PRESENTATION</div>
                <div class="form-group">
                    <label>Target Resolution</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="output_res == 'auto'" data-event-click="set_resolution('auto')">Auto (Desktop)</button>
                        <button class="sel-btn" data-class-active="output_res == '1920x1080'" data-event-click="set_resolution('1920x1080')">1080p</button>
                        <button class="sel-btn" data-class-active="output_res == '2560x1440'" data-event-click="set_resolution('2560x1440')">1440p</button>
                        <button class="sel-btn" data-class-active="output_res == '3840x2160'" data-event-click="set_resolution('3840x2160')">4K UHD</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Aspect Ratio</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="aspect_ratio == 'auto'" data-event-click="set_aspect_ratio('auto')">Auto</button>
                        <button class="sel-btn" data-class-active="aspect_ratio == '16:9'" data-event-click="set_aspect_ratio('16:9')">16:9</button>
                        <button class="sel-btn" data-class-active="aspect_ratio == '21:9'" data-event-click="set_aspect_ratio('21:9')">21:9 (Ultrawide)</button>
                        <button class="sel-btn" data-class-active="aspect_ratio == '32:9'" data-event-click="set_aspect_ratio('32:9')">32:9 (Superwide)</button>
                        <button class="sel-btn" data-class-active="aspect_ratio == '16:10'" data-event-click="set_aspect_ratio('16:10')">16:10</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Vulkan Presentation Mode</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="present_mode == 'Mailbox'" data-event-click="set_present_mode('Mailbox')">Mailbox (Uncapped/Fast)</button>
                        <button class="sel-btn" data-class-active="present_mode == 'Fifo'" data-event-click="set_present_mode('Fifo')">FIFO (Standard VSync)</button>
                        <button class="sel-btn" data-class-active="present_mode == 'FifoRelaxed'" data-event-click="set_present_mode('FifoRelaxed')">FIFO Relaxed</button>
                        <button class="sel-btn" data-class-active="present_mode == 'Immediate'" data-event-click="set_present_mode('Immediate')">Immediate (No VSync)</button>
                    </div>
                </div>

                <div class="toggle-row">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="fullscreen" data-event-change="save" />
                        Fullscreen Mode
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="borderless" data-event-change="save" />
                        Borderless Windowed
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="hdr" data-event-change="save" />
                        HDR Output (Vulkan)
                    </label>
                </div>
            </div>

            <div class="card">
                <div class="card-title">UPSCALING &amp; ANTI-ALIASING</div>
                <div class="form-group">
                    <label>Upscaler Backend</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="upscaler == 'fsr4'" data-event-click="set_upscaler('fsr4')">AMD FSR 4</button>
                        <button class="sel-btn" data-class-active="upscaler == 'fsr411'" data-event-click="set_upscaler('fsr411')">FSR 4.1.1</button>
                        <button class="sel-btn" data-class-active="upscaler == 'fsr3'" data-event-click="set_upscaler('fsr3')">AMD FSR 3.1</button>
                        <button class="sel-btn" data-class-active="upscaler == 'dlss'" data-event-click="set_upscaler('dlss')">NVIDIA DLSS</button>
                        <button class="sel-btn" data-class-active="upscaler == 'fsr1'" data-event-click="set_upscaler('fsr1')">FSR 1</button>
                        <button class="sel-btn" data-class-active="upscaler == 'taa'" data-event-click="set_upscaler('taa')">Native TAA</button>
                        <button class="sel-btn" data-class-active="upscaler == 'off'" data-event-click="set_upscaler('off')">Off</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Frame Generation</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="frame_generation == 'off'" data-event-click="set_frame_generation('off')">Off</button>
                        <button class="sel-btn" data-class-active="frame_generation == 'fsr'" data-event-click="set_frame_generation('fsr')">AMD FSR 3.1 FG</button>
                        <button class="sel-btn" data-class-active="frame_generation == 'dlss'" data-event-click="set_frame_generation('dlss')">DLSS Frame Gen</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Anti-Aliasing</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="anti_aliasing == 'auto'" data-event-click="set_anti_aliasing('auto')">Auto</button>
                        <button class="sel-btn" data-class-active="anti_aliasing == 'game'" data-event-click="set_anti_aliasing('game')">Game Original</button>
                        <button class="sel-btn" data-class-active="anti_aliasing == 'fxaa'" data-event-click="set_anti_aliasing('fxaa')">FXAA2_GS</button>
                        <button class="sel-btn" data-class-active="anti_aliasing == 'smaa'" data-event-click="set_anti_aliasing('smaa')">SMAA</button>
                        <button class="sel-btn" data-class-active="anti_aliasing == 'off'" data-event-click="set_anti_aliasing('off')">Off</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Texture Quality</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="texture_quality == 'auto'" data-event-click="set_texture_quality('auto')">Auto</button>
                        <button class="sel-btn" data-class-active="texture_quality == 'full'" data-event-click="set_texture_quality('full')">Full (Original)</button>
                        <button class="sel-btn" data-class-active="texture_quality == 'half'" data-event-click="set_texture_quality('half')">Half (VRAM Saver)</button>
                        <button class="sel-btn" data-class-active="texture_quality == 'quarter'" data-event-click="set_texture_quality('quarter')">Quarter</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Model Level of Detail (LOD)</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="model_lod == 0" data-event-click="set_model_lod('0')">High (0)</button>
                        <button class="sel-btn" data-class-active="model_lod == -2" data-event-click="set_model_lod('-2')">Maximum Distance (-2)</button>
                        <button class="sel-btn" data-class-active="model_lod == 1" data-event-click="set_model_lod('1')">Medium (1)</button>
                        <button class="sel-btn" data-class-active="model_lod == 2" data-event-click="set_model_lod('2')">Low (2)</button>
                    </div>
                </div>

                <div class="toggle-row">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="sharpen" data-event-change="save" />
                        CAS Sharpening Filter
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="vbao" data-event-change="save" />
                        GT-VBAO Ambient Occlusion
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="show_fps" data-event-change="save" />
                        In-Game FPS Counter
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="object_motion" data-event-change="save" />
                        Object Motion Vectors
                    </label>
                </div>
            </div>
        </div>

        <!-- TAB: EFFECTS & ENGINE -->
        <div class="tab-pane" data-if="active_tab == 'effects'">
            <div class="pane-header">
                <h2>EFFECTS &amp; ENGINE</h2>
                <p class="pane-desc">Graphical post-processing effects, shadows, and low-latency rendering pipeline.</p>
            </div>

            <div class="card">
                <div class="card-title">POST-PROCESSING &amp; CINEMATIC EFFECTS</div>
                <div class="toggle-grid">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="motion_blur" data-event-change="save" />
                        Motion Blur
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="bloom" data-event-change="save" />
                        Bloom Lighting
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="chromatic_aberration" data-event-change="save" />
                        Chromatic Aberration
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="dof" data-event-change="save" />
                        Depth of Field (DoF)
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="ssao" data-event-change="save" />
                        Screen-Space Ambient Occlusion (SSAO)
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="dynamic_shadows" data-event-change="save" />
                        High-Resolution Dynamic Shadows
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="effect_ssr" data-event-change="save" />
                        Screen-Space Reflections (SSR)
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="skip_intro" data-event-change="save" />
                        Skip Opening Logos / Intro
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="debug_camera" data-event-change="save" />
                        Free Debug Camera Mode
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="debug_menu" data-event-change="save" />
                        In-Game Debug Menu (Hold L3+R3)
                    </label>
                </div>
            </div>

            <div class="card">
                <div class="card-title">PERFORMANCE &amp; PIPELINE</div>
                <div class="form-group">
                    <label>Framerate Mode</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="fps_mode == 'uncap'" data-event-click="set_fps_mode('uncap')">Uncapped</button>
                        <button class="sel-btn" data-class-active="fps_mode == '60'" data-event-click="set_fps_mode('60')">60 FPS Cap</button>
                        <button class="sel-btn" data-class-active="fps_mode == '90'" data-event-click="set_fps_mode('90')">90 FPS Cap</button>
                        <button class="sel-btn" data-class-active="fps_mode == '30'" data-event-click="set_fps_mode('30')">30 FPS (Vanilla)</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Low Latency (NVIDIA Reflex / AMD Anti-Lag 2)</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="low_latency == 'on'" data-event-click="set_low_latency('on')">On</button>
                        <button class="sel-btn" data-class-active="low_latency == 'boost'" data-event-click="set_low_latency('boost')">On + Boost</button>
                        <button class="sel-btn" data-class-active="low_latency == 'off'" data-event-click="set_low_latency('off')">Off</button>
                    </div>
                </div>

                <div class="toggle-grid">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="vk_validation" data-event-change="save" />
                        Vulkan Validation Layers
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="mangohud" data-event-change="save" />
                        Enable MangoHud Overlay
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="frame_stats" data-event-change="save" />
                        Collect Detailed Frame Stats
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="gpu_profile" data-event-change="save" />
                        GPU Profiling Trace
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="crash_diag" data-event-change="save" />
                        Crash Diagnostics Memory Dump
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="save_log" data-event-change="save" />
                        Save Process Output to Log File
                    </label>
                </div>

                <div class="form-group" style="margin-top: 14px;">
                    <label>Extra Environment Variables (e.g. VK_LAYER_PATH=/path)</label>
                    <input type="text" class="text-input" data-value="extra_env" data-event-change="save" />
                </div>
            </div>
        </div>

        <!-- TAB: CONTROLS & INPUT -->
        <div class="tab-pane" data-if="active_tab == 'controls'">
            <div class="pane-header">
                <h2>CONTROLS &amp; INPUT</h2>
                <p class="pane-desc">Camera look mechanics, mouse emulation sensitivity, and controller button layouts.</p>
            </div>

            <div class="card">
                <div class="card-title">CONTROLLER BUTTON PROMPTS</div>
                <div class="button-selector">
                    <button class="sel-btn" data-class-active="button_prompts == 'auto'" data-event-click="set_button_prompts('auto')">Auto-Detect</button>
                    <button class="sel-btn" data-class-active="button_prompts == 'playstation'" data-event-click="set_button_prompts('playstation')">PlayStation (○ ✕ □ △)</button>
                    <button class="sel-btn" data-class-active="button_prompts == 'xbox'" data-event-click="set_button_prompts('xbox')">Xbox (A B X Y)</button>
                    <button class="sel-btn" data-class-active="button_prompts == 'keyboard'" data-event-click="set_button_prompts('keyboard')">Keyboard &amp; Mouse</button>
                </div>
            </div>

            <div class="card">
                <div class="card-title">MOUSE LOOK &amp; CAMERA SETTINGS</div>
                <div class="toggle-row">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="mouse_look" data-event-change="save" />
                        Enable Mouse Look (Camera Navigation)
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="mouse_invert_y" data-event-change="save" />
                        Invert Y Axis
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="mouse_invert_x" data-event-change="save" />
                        Invert X Axis
                    </label>
                </div>
            </div>
        </div>

        <!-- TAB: MODS & PATCHES -->
        <div class="tab-pane" data-if="active_tab == 'mods'">
            <div class="pane-header">
                <h2>MODS &amp; SHADPS4 PATCHES</h2>
                <p class="pane-desc">Manage installed game modifications, load order priority, and XML runtime patches.</p>
            </div>

            <div class="card">
                <div class="card-title">GLOBAL MODS STATUS</div>
                <div class="toggle-row">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="mods_enabled" data-event-change="save" />
                        Enable All Game Modifications
                    </label>
                </div>
            </div>

            <div class="card">
                <div class="card-title">INSTALLED MODS (LOAD ORDER)</div>
                <div class="mods-list">
                    <div class="mod-item" data-for="mod : mods_list">
                        <div class="mod-left">
                            <input type="checkbox" class="input-checkbox" data-checked="mod.enabled" data-event-change="toggle_mod(mod.id)" />
                            <div class="mod-info">
                                <div class="mod-title">{{ mod.name }}</div>
                                <div class="mod-path">{{ mod.path }}</div>
                            </div>
                        </div>
                        <div class="mod-actions">
                            <button class="btn-tiny" data-event-click="move_mod_up(mod.id)">▲</button>
                            <button class="btn-tiny" data-event-click="move_mod_down(mod.id)">▼</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card" data-if="patches_list.size > 0">
                <div class="card-title">SHADPS4 XML PATCHES</div>
                <div class="patches-list">
                    <div class="patch-item" data-for="patch : patches_list">
                        <input type="checkbox" class="input-checkbox" data-checked="patch.enabled" data-event-change="toggle_patch(patch.id)" />
                        <div class="patch-info">
                            <div class="patch-title">{{ patch.name }}</div>
                            <div class="patch-author" data-if="patch.author != ''">Author: {{ patch.author }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: TROPHIES -->
        <div class="tab-pane" data-if="active_tab == 'trophies'">
            <div class="pane-header">
                <h2>ACHIEVEMENTS &amp; TROPHIES</h2>
                <p class="pane-desc">Decrypted game trophies, unlock milestones, and Yharnam hunter completion.</p>
            </div>

            <div class="card trophy-summary-card">
                <div class="trophy-summary-header">
                    <span class="trophy-summary-title">COMPLETION STATUS</span>
                    <span class="trophy-summary-stat">{{ trophy_progress_text }}</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill trophy-progress-fill" data-style-width="trophy_progress_pct + '%'"></div>
                </div>
            </div>

            <div class="trophy-grid">
                <div class="trophy-card" data-for="t : trophies_list" data-class-unlocked="t.unlocked">
                    <div class="trophy-grade-badge" data-class-plat="t.grade_str == 'Platinum'" data-class-gold="t.grade_str == 'Gold'" data-class-silver="t.grade_str == 'Silver'" data-class-bronze="t.grade_str == 'Bronze'">
                        {{ t.grade_str }}
                    </div>
                    <div class="trophy-content">
                        <div class="trophy-title">{{ t.name }}</div>
                        <div class="trophy-detail">{{ t.detail }}</div>
                        <div class="trophy-date" data-if="t.unlocked &amp;&amp; t.date_str != ''">Unlocked: {{ t.date_str }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: ONLINE -->
        <div class="tab-pane" data-if="active_tab == 'online'">
            <div class="pane-header">
                <h2>NETWORK &amp; CO-OP</h2>
                <p class="pane-desc">Seamless multiplayer matchmaking, BBSC local server, and NP communication pools.</p>
            </div>

            <div class="card">
                <div class="card-title">MULTIPLAYER CONFIGURATION</div>
                <div class="toggle-row">
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="online_enabled" data-event-change="save" />
                        Enable Online Multiplayer
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="local_bbsc" data-event-change="save" />
                        Run Local BBSC Co-op Relay Server
                    </label>
                    <label class="toggle-label">
                        <input type="checkbox" class="input-checkbox" data-checked="online_upnp" data-event-change="save" />
                        Enable UPnP Port Forwarding
                    </label>
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label>Matchmaking Pool</label>
                    <div class="button-selector">
                        <button class="sel-btn" data-class-active="online_pool == 'seamless'" data-event-click="set_pool('seamless')">Seamless Hunt + BBSC</button>
                        <button class="sel-btn" data-class-active="online_pool == 'huntersdream'" data-event-click="set_pool('huntersdream')">The Hunter's Dream</button>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label>Multiplayer Server Address</label>
                    <input type="text" class="text-input" data-value="online_server" data-event-change="save" />
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label>Custom Online NPID</label>
                    <input type="text" class="text-input" data-value="online_npid" data-event-change="save" />
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label>Matchmaking Password (Co-op Session Filter)</label>
                    <input type="text" class="text-input" data-value="online_password" data-event-change="save" />
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label>Discord Login Token (Optional for The Hunter's Dream)</label>
                    <input type="text" class="text-input" data-value="discord_token" data-event-change="save" />
                </div>
            </div>
        </div>

        <!-- TAB: LOG & CONSOLE -->
        <div class="tab-pane" data-if="active_tab == 'log'">
            <div class="pane-header">
                <h2>LOG &amp; PROCESS CONSOLE</h2>
                <p class="pane-desc">Live output stream from execution layer, Vulkan initialization, and runtime diagnostics.</p>
            </div>

            <div class="card log-card">
                <div class="log-controls">
                    <button class="btn-action" data-event-click="clear_log">CLEAR</button>
                    <button class="btn-action" data-event-click="copy_log">{{ copy_btn_text }}</button>
                    <button class="btn-action" data-event-click="save_log">EXPORT TO FILE...</button>
                </div>
                <div class="log-viewport">
                    <pre class="log-text">{{ console_log }}</pre>
                </div>
            </div>
        </div>

    </div>
</body>
</rml>
