/* ==========================================================================
   Bloodborne PC Native Client - Stylesheet (RmlUi)
   Victorian Gothic Game Launcher Experience
   ========================================================================== */

/* Universal Block Reset for RmlUi (Rules R-01 & R-02) */
div, p, h1, h2, h3, h4, section, header, footer, span, label, button, input {
    box-sizing: border-box;
}

div, p, h1, h2, h3, h4, section, header, footer {
    display: block;
}

body {
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;
    bottom: 0px;
    margin: 0px;
    padding: 0px;
    background-color: #07060a;
    color: #ede5d8;
    font-family: Source Sans 3;
    font-size: 13px;
    overflow: hidden;
}

/* ==========================================================================
   SIDEBAR NAVIGATION & BRANDING
   ========================================================================== */

#sidebar {
    position: absolute;
    top: 0px;
    left: 0px;
    bottom: 0px;
    width: 230px;
    background-color: #09070f;
    border-right: 1px #1d1628;
    padding: 24px 16px;
    box-sizing: border-box;
}

.brand {
    display: block;
    margin-bottom: 24px;
    padding-left: 6px;
}

.brand-title {
    display: block;
    font-family: Cinzel;
    font-size: 20px;
    font-weight: bold;
    color: #f2ece1;
    letter-spacing: 4px;
    margin-bottom: 3px;
}

.brand-subtitle {
    display: block;
    font-family: Cormorant;
    font-size: 11px;
    font-weight: bold;
    color: #c5a059;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.brand-divider {
    display: block;
    height: 2px;
    width: 46px;
    background-color: #8f1818;
}

.nav-menu {
    display: block;
    margin-top: 14px;
}

.nav-item {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background-color: transparent;
    border: 0px;
    border-left: 3px transparent;
    color: #8a7f92;
    font-family: Cinzel;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    text-align: left;
    padding: 10px 12px;
    margin-bottom: 4px;
    border-radius: 0px 4px 4px 0px;
    cursor: pointer;
    transition: background-color 0.15s cubic-out, color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.12s cubic-out;
}

.nav-icon {
    display: inline-block;
    width: 20px;
    margin-right: 8px;
    font-size: 13px;
    vertical-align: middle;
}

.nav-text {
    display: inline-block;
    vertical-align: middle;
}

.nav-item:hover {
    background-color: #161120;
    color: #f2ece1;
    transform: translateX(3px);
}

.nav-item:active {
    transform: translateX(1px);
}

.nav-item.active {
    background-color: #1e1529;
    border-left: 3px #8f1818;
    color: #f2ece1;
    font-weight: bold;
    transform: translateX(0px);
}

.sidebar-footer {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    padding-left: 6px;
    border-top: 1px #1d1628;
    padding-top: 12px;
}

.lang-selector {
    display: block;
    margin-bottom: 8px;
}

.lang-label {
    display: block;
    font-family: Cinzel;
    font-size: 10px;
    font-weight: bold;
    color: #8a7f92;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.lang-btns {
    display: block;
}

.lang-btn {
    display: inline-block;
    background-color: #130e1a;
    color: #8a7f92;
    border: 1px #241b30;
    border-radius: 3px;
    padding: 3px 6px;
    font-family: JetBrainsMono NF;
    font-size: 10px;
    font-weight: bold;
    cursor: pointer;
    margin-right: 4px;
    transition: background-color 0.12s cubic-out, color 0.12s cubic-out, border-color 0.12s cubic-out, transform 0.1s cubic-out;
}

.lang-btn:hover {
    background-color: #21182c;
    color: #ede5d8;
    border-color: #c5a059;
    transform: translateY(-1px);
}

.lang-btn:active {
    background-color: #0e0a13;
    transform: translateY(1px);
}

.lang-btn.active {
    background-color: #8f1818;
    color: #ffffff;
    border-color: #b51d1d;
}

.sidebar-meta {
    display: block;
    margin-top: 6px;
}

.meta-client {
    display: block;
    font-family: JetBrainsMono NF;
    font-size: 10px;
    color: #5c5365;
}

/* ==========================================================================
   MAIN CONTENT VIEWPORT
   ========================================================================== */

#content {
    position: absolute;
    top: 0px;
    left: 230px;
    right: 0px;
    bottom: 0px;
    background-color: #0d0a14;
    padding: 24px 28px;
    box-sizing: border-box;
    overflow-y: auto;
}

@keyframes tabEnter {
    from {
        opacity: 0.0;
        transform: translateY(4px);
    }
    to {
        opacity: 1.0;
        transform: translateY(0px);
    }
}

.tab-pane {
    display: block;
    width: 100%;
    animation: tabEnter 0.18s cubic-out;
}

.pane-header {
    display: block;
    margin-bottom: 20px;
}

.pane-title {
    display: block;
    font-family: Cinzel;
    font-size: 20px;
    font-weight: bold;
    color: #f2ece1;
    margin-bottom: 4px;
    letter-spacing: 2px;
}

.pane-desc {
    display: block;
    font-family: Cormorant;
    font-size: 14px;
    color: #8a7f92;
    line-height: 1.4;
}

/* Standard Gothic Cards */
.card {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background-color: #130e1a;
    border: 1px #22192d;
    border-radius: 6px;
    padding: 18px 22px;
    margin-bottom: 18px;
    transition: border-color 0.15s cubic-out, background-color 0.15s cubic-out;
}

.card:hover {
    border-color: #3b2c4e;
}

.card-header, .card-title {
    display: block;
    font-family: Cinzel;
    font-size: 11px;
    font-weight: bold;
    color: #c5a059;
    letter-spacing: 2.5px;
    border-bottom: 1px #1f1729;
    padding-bottom: 8px;
    margin-bottom: 14px;
}

/* ==========================================================================
   DASHBOARD HERO & CHRONICLES SECTION (TABLE-CELL NO-WRAP ENGINE)
   ========================================================================== */

.dashboard-top {
    display: table;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 20px;
}

.hero-col {
    display: table-cell;
    width: 67%;
    vertical-align: top;
    padding-right: 16px;
    box-sizing: border-box;
}

.notes-col {
    display: table-cell;
    width: 33%;
    vertical-align: top;
    box-sizing: border-box;
}

.hero-card {
    display: block;
    width: 100%;
    height: 288px;
    background-color: #130e1a;
    border: 1px #22192d;
    border-radius: 8px;
    overflow: hidden;
    box-sizing: border-box;
    transition: border-color 0.15s cubic-out;
}

.hero-card:hover {
    border-color: #3e2e52;
}

.hero-art-bg {
    display: block;
    height: 190px;
    background-color: #1a1223;
    decorator: vertical-gradient(#271735 #110b19);
    padding: 24px 28px;
    box-sizing: border-box;
    border-bottom: 1px #23192e;
}

.hero-badge {
    display: inline-block;
    font-family: Cinzel;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2.5px;
    color: #c5a059;
    background-color: #26131c;
    border: 1px #6b1414;
    border-radius: 3px;
    padding: 4px 10px;
    margin-bottom: 12px;
}

.hero-title {
    display: block;
    font-family: Cinzel;
    font-size: 28px;
    font-weight: bold;
    color: #f5efe6;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.hero-quote {
    display: block;
    font-family: Cormorant;
    font-size: 15px;
    color: #9c9183;
    line-height: 1.45;
}

.hero-action-bar {
    display: block;
    height: 98px;
    padding: 18px 24px;
    background-color: #0d0913;
    box-sizing: border-box;
}

.hero-play-btn {
    display: inline-block;
    vertical-align: middle;
    width: 240px;
    background-color: #8f1818;
    decorator: vertical-gradient(#aa1d1d #781313);
    border: 1px #b52020;
    border-radius: 4px;
    color: #ffffff;
    font-family: Cinzel;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 15px 18px;
    cursor: pointer;
    text-align: center;
    box-sizing: border-box;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.12s cubic-out;
}

.hero-play-btn:hover {
    background-color: #a81c1c;
    border-color: #c5a059;
    transform: translateY(-2px);
}

.hero-play-btn:active {
    background-color: #6e1010;
    transform: translateY(1px) scale(0.99);
}

.hero-stop-btn {
    display: inline-block;
    vertical-align: middle;
    width: 240px;
    background-color: #4a0f12;
    border: 1px #70161a;
    border-radius: 4px;
    color: #ffffff;
    font-family: Cinzel;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 15px 18px;
    cursor: pointer;
    text-align: center;
    box-sizing: border-box;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.12s cubic-out;
}

.hero-stop-btn:hover {
    background-color: #631418;
    border-color: #c5a059;
    transform: translateY(-2px);
}

.hero-stop-btn:active {
    background-color: #380b0e;
    transform: translateY(1px);
}

.hero-status-block {
    display: inline-block;
    vertical-align: middle;
    margin-left: 20px;
}

.hero-status-tag {
    display: block;
    font-family: Cinzel;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
}

.status-indicator.ready {
    color: #38a169;
}

.status-indicator.update {
    color: #e59b2b;
}

.status-indicator.unlinked {
    color: #d93838;
}

.status-indicator.running {
    color: #e53e3e;
}

.hero-status-desc {
    display: block;
    font-family: JetBrainsMono NF;
    font-size: 11px;
    color: #8a7f92;
}

/* Notes / Chronicles Card */
.notes-card {
    display: block;
    width: 100%;
    height: 288px;
    background-color: #130e1a;
    border: 1px #22192d;
    border-radius: 8px;
    padding: 20px 22px;
    box-sizing: border-box;
    overflow: hidden;
    transition: border-color 0.15s cubic-out, background-color 0.15s cubic-out;
}

.notes-card:hover {
    border-color: #3e2e52;
}

.card-label {
    display: block;
    font-family: Cinzel;
    font-size: 10px;
    font-weight: bold;
    color: #c5a059;
    letter-spacing: 2.5px;
    margin-bottom: 6px;
    text-transform: uppercase;
}

.notes-title {
    display: block;
    font-family: Cinzel;
    font-size: 18px;
    font-weight: bold;
    color: #f2ece1;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.notes-ver-tag {
    display: block;
    margin-bottom: 12px;
}

.badge-ver {
    display: inline-block;
    font-family: JetBrainsMono NF;
    font-size: 10px;
    font-weight: bold;
    color: #c5a059;
    border: 1px #4d3a24;
    border-radius: 3px;
    padding: 2px 7px;
    margin-right: 6px;
}

.badge-tag {
    display: inline-block;
    font-family: Source Sans 3;
    font-size: 10px;
    font-weight: bold;
    color: #ffffff;
    background-color: #8f1818;
    border-radius: 3px;
    padding: 2px 6px;
    margin-right: 6px;
}

.badge-date {
    display: inline-block;
    font-family: Source Sans 3;
    font-size: 11px;
    color: #7e7387;
}

.notes-body {
    display: block;
    border-top: 1px #20172c;
    padding-top: 10px;
}

.note-bullet {
    display: block;
    font-family: Source Sans 3;
    font-size: 12px;
    color: #aba0b3;
    line-height: 1.5;
    margin-bottom: 6px;
}

/* ==========================================================================
   4 MODULAR UTILITY CARDS GRID (EQUAL TABLE-CELL DISTRIBUTION)
   ========================================================================== */

.utility-grid {
    display: table;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 22px;
}

.util-col {
    display: table-cell;
    width: 25%;
    box-sizing: border-box;
    padding-right: 14px;
    vertical-align: top;
}

.util-col:last-child {
    padding-right: 0px;
}

.util-card {
    display: block;
    width: 100%;
    height: 175px;
    position: relative;
    background-color: #130e1a;
    border: 1px #22192d;
    border-radius: 6px;
    padding: 16px 18px;
    box-sizing: border-box;
    transition: border-color 0.15s cubic-out, background-color 0.15s cubic-out, transform 0.12s cubic-out;
}

.util-card:hover {
    border-color: #46345c;
    background-color: #181222;
    transform: translateY(-2px);
}

.util-status {
    display: block;
    margin-top: 8px;
    margin-bottom: 6px;
}

.status-check {
    display: inline-block;
    color: #38a169;
    font-size: 13px;
    font-weight: bold;
    margin-right: 6px;
    vertical-align: middle;
}

.status-warn {
    display: inline-block;
    color: #e59b2b;
    font-size: 13px;
    font-weight: bold;
    margin-right: 6px;
    vertical-align: middle;
}

.status-info {
    display: inline-block;
    color: #c5a059;
    font-size: 13px;
    font-weight: bold;
    margin-right: 6px;
    vertical-align: middle;
}

.status-text {
    display: inline-block;
    font-family: Cinzel;
    font-size: 11px;
    font-weight: bold;
    color: #f2ece1;
    letter-spacing: 1.5px;
    vertical-align: middle;
}

.status-text.warn {
    color: #e59b2b;
}

.util-detail {
    display: block;
    font-family: JetBrainsMono NF;
    font-size: 11px;
    color: #8a7f92;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 4px;
    min-height: 16px;
}

.util-sub {
    display: block;
    font-family: Source Sans 3;
    font-size: 11px;
    color: #6a6173;
    margin-bottom: 8px;
    min-height: 16px;
}

.util-actions {
    position: absolute;
    bottom: 14px;
    left: 18px;
    right: 18px;
    display: block;
}

.btn-micro {
    display: inline-block;
    background-color: #1a1324;
    border: 1px #2d213c;
    border-radius: 3px;
    color: #c5a059;
    font-family: Cinzel;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 6px 12px;
    cursor: pointer;
    margin-right: 8px;
    vertical-align: middle;
    box-sizing: border-box;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, color 0.15s cubic-out, transform 0.1s cubic-out;
}

.btn-micro:hover {
    background-color: #271b37;
    border-color: #c5a059;
    color: #ffffff;
    transform: translateY(-1px);
}

.btn-micro:active {
    background-color: #120d1a;
    transform: translateY(1px) scale(0.98);
}

.btn-micro.btn-red {
    background-color: #6e1414;
    border-color: #8f1818;
    color: #ffffff;
}

.btn-micro.btn-red:hover {
    background-color: #8f1818;
    border-color: #b51d1d;
    transform: translateY(-1px);
}

.btn-micro.btn-red:active {
    background-color: #4a0d0d;
    transform: translateY(1px) scale(0.98);
}

/* ==========================================================================
   INTERACTIVE BUTTONS, SELECTORS & INPUTS
   ========================================================================== */

.button-selector {
    display: block;
    margin-top: 6px;
    margin-bottom: 10px;
}

.sel-btn {
    display: inline-block;
    background-color: #171120;
    border: 1px #2b1f3a;
    border-radius: 4px;
    color: #9c91a6;
    font-family: Source Sans 3;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 14px;
    margin-right: 8px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, color 0.15s cubic-out, transform 0.1s cubic-out;
}

.sel-btn:hover {
    background-color: #241a33;
    border-color: #3f2e54;
    color: #ede5d8;
    transform: translateY(-1px);
}

.sel-btn:active {
    transform: scale(0.98);
}

.sel-btn.active {
    background-color: #8f1818;
    border-color: #c5a059;
    color: #ffffff;
    transform: translateY(0px);
}

.action-btn, .btn-action {
    display: inline-block;
    background-color: #1a1324;
    border: 1px #2d213c;
    border-radius: 4px;
    color: #ede5d8;
    font-family: JetBrainsMono NF;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 8px 16px;
    cursor: pointer;
    text-align: center;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, color 0.15s cubic-out, transform 0.1s cubic-out;
}

.action-btn:hover, .btn-action:hover {
    background-color: #271b37;
    border-color: #c5a059;
    color: #ffffff;
    transform: translateY(-1px);
}

.action-btn:active, .btn-action:active {
    background-color: #120d1a;
    transform: translateY(1px) scale(0.98);
}

.btn-secondary {
    display: inline-block;
    background-color: #171120;
    border: 1px #2b1f3a;
    border-radius: 4px;
    color: #9c91a6;
    font-family: Cinzel;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 8px 16px;
    cursor: pointer;
    margin-right: 8px;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, color 0.15s cubic-out, transform 0.1s cubic-out;
}

.btn-secondary:hover {
    background-color: #241a33;
    border-color: #c5a059;
    color: #ffffff;
    transform: translateY(-1px);
}

.btn-secondary:active {
    background-color: #120d1a;
    transform: translateY(1px);
}

/* Text Inputs */
.text-input, input.text {
    display: inline-block;
    background-color: #09070d;
    border: 1px #241b30;
    border-radius: 4px;
    color: #f2ece1;
    font-family: JetBrainsMono NF;
    font-size: 12px;
    padding: 8px 12px;
    box-sizing: border-box;
    transition: border-color 0.15s cubic-out, background-color 0.15s cubic-out;
}

.text-input:hover, input.text:hover {
    border-color: #3e2e52;
    background-color: #0e0a14;
}

.text-input:focus, input.text:focus {
    border-color: #c5a059;
    background-color: #0e0a14;
}

.form-group {
    display: block;
    margin-bottom: 14px;
}

.form-group label {
    display: block;
    font-size: 12px;
    color: #8a7f92;
    margin-bottom: 6px;
}

.input-row {
    display: block;
    width: 100%;
}

.input-row .text-input {
    display: inline-block;
    width: 78%;
    vertical-align: middle;
}

.input-row .btn-action {
    display: inline-block;
    width: 18%;
    margin-left: 2%;
    vertical-align: middle;
}

.button-row {
    display: block;
    margin-top: 14px;
}

/* Checkboxes */
input.checkbox, .input-checkbox {
    display: inline-block;
    width: 18px;
    height: 18px;
    background-color: #09070d;
    border: 1px #281e35;
    border-radius: 3px;
    vertical-align: middle;
    margin-right: 10px;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.1s cubic-out;
}

input.checkbox:hover, .input-checkbox:hover {
    border-color: #8f1818;
    background-color: #140e1d;
    transform: scale(1.05);
}

input.checkbox:checked, .input-checkbox:checked {
    background-color: #8f1818;
    border-color: #c5a059;
}

input.checkbox:active, .input-checkbox:active {
    transform: scale(0.95);
}

.toggle-row {
    display: block;
    margin-top: 10px;
}

.toggle-grid {
    display: block;
    margin-top: 10px;
}

.toggle-label {
    display: inline-block;
    font-size: 13px;
    color: #c9bfb0;
    vertical-align: middle;
    cursor: pointer;
    line-height: 24px;
    margin-right: 20px;
    margin-bottom: 12px;
}

.toggle-grid .toggle-label {
    width: 48%;
    margin-right: 2%;
    box-sizing: border-box;
}

.toggle-label:hover {
    color: #ffffff;
}

/* Extraction Progress */
.extract-card {
    background-color: #130e1a;
    border: 1px #8f1818;
    padding: 14px 18px;
    margin-bottom: 16px;
}

.extract-header {
    display: block;
    margin-bottom: 8px;
}

.extract-label {
    display: inline-block;
    font-family: Cinzel;
    font-size: 11px;
    font-weight: bold;
    color: #c5a059;
}

.extract-pct {
    display: inline-block;
    float: right;
    font-family: JetBrainsMono NF;
    font-size: 11px;
    font-weight: bold;
    color: #8f1818;
}

.progress-bar {
    display: block;
    width: 100%;
    height: 6px;
    background-color: #09070d;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 6px;
}

.progress-fill {
    display: block;
    height: 100%;
    background-color: #8f1818;
}

.extract-status {
    display: block;
    font-size: 11px;
    color: #8a7f92;
}

/* ==========================================================================
   MODS & PATCHES
   ========================================================================== */

.mods-list, .patches-list {
    display: block;
    margin-top: 8px;
}

.mod-item, .patch-item {
    display: block;
    background-color: #100b16;
    border: 1px #1e1628;
    border-radius: 4px;
    padding: 10px 14px;
    margin-bottom: 8px;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.1s cubic-out;
}

.mod-item:hover, .patch-item:hover {
    background-color: #171120;
    border-color: #3e2e52;
    transform: translateX(2px);
}

.mod-left {
    display: inline-block;
    width: 80%;
    vertical-align: middle;
}

.mod-left input {
    display: inline-block;
    vertical-align: middle;
    margin-right: 12px;
}

.mod-info, .patch-info {
    display: inline-block;
    vertical-align: middle;
    width: 85%;
}

.mod-title, .patch-title {
    display: block;
    font-size: 13px;
    font-weight: bold;
    color: #f2ece1;
}

.mod-path, .patch-author {
    display: block;
    font-family: JetBrainsMono NF;
    font-size: 11px;
    color: #8a7f92;
    margin-top: 2px;
}

.mod-actions {
    display: inline-block;
    width: 18%;
    text-align: right;
    vertical-align: middle;
}

.btn-tiny {
    display: inline-block;
    background-color: #1a1324;
    color: #c5a059;
    border: 1px #2d213c;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: bold;
    cursor: pointer;
    margin-left: 4px;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out, transform 0.1s cubic-out;
}

.btn-tiny:hover {
    background-color: #271b37;
    border-color: #c5a059;
    color: #ffffff;
    transform: translateY(-1px);
}

.btn-tiny:active {
    background-color: #120d1a;
    transform: translateY(1px);
}

/* ==========================================================================
   TROPHIES (HUNTER'S RECORDS)
   ========================================================================== */

.trophy-summary-card {
    background-color: #130e1a;
    border: 1px #22192d;
    padding: 16px;
    margin-bottom: 18px;
}

.trophy-summary-header {
    display: block;
    margin-bottom: 8px;
}

.trophy-summary-title {
    display: inline-block;
    font-family: Cinzel;
    font-size: 12px;
    font-weight: bold;
    color: #c5a059;
    letter-spacing: 1.5px;
}

.trophy-summary-stat {
    display: inline-block;
    float: right;
    font-family: JetBrainsMono NF;
    font-size: 12px;
    font-weight: bold;
    color: #f2ece1;
}

.trophy-progress-fill {
    background-color: #c5a059;
}

.trophy-grid {
    display: block;
}

.trophy-card {
    display: block;
    background-color: #100b16;
    border: 1px #1e1628;
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 10px;
    opacity: 0.6;
    transition: opacity 0.15s cubic-out, border-color 0.15s cubic-out, background-color 0.15s cubic-out, transform 0.1s cubic-out;
}

.trophy-card:hover {
    opacity: 0.85;
    border-color: #3e2e52;
    background-color: #171120;
    transform: translateY(-1px);
}

.trophy-card.unlocked {
    opacity: 1.0;
    border-color: #4a3860;
    background-color: #181122;
}

.trophy-card.unlocked:hover {
    border-color: #c5a059;
    transform: translateY(-2px);
}

.trophy-grade-badge {
    display: inline-block;
    vertical-align: middle;
    width: 80px;
    font-family: Cinzel;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #8a7f92;
}

.trophy-grade-badge.plat {
    color: #a3c4f3;
}

.trophy-grade-badge.gold {
    color: #ffd166;
}

.trophy-grade-badge.silver {
    color: #cfd2cd;
}

.trophy-grade-badge.bronze {
    color: #cd7f32;
}

.trophy-content {
    display: inline-block;
    vertical-align: middle;
    width: 80%;
}

.trophy-title {
    display: block;
    font-size: 14px;
    font-weight: bold;
    color: #f2ece1;
}

.trophy-detail {
    display: block;
    font-size: 12px;
    color: #8a7f92;
    margin-top: 3px;
}

.trophy-date {
    display: block;
    font-family: JetBrainsMono NF;
    font-size: 11px;
    color: #c5a059;
    margin-top: 4px;
}

/* ==========================================================================
   LOG & PROCESS CONSOLE TAB
   ========================================================================== */

.log-card {
    padding: 18px;
}

.log-controls {
    display: block;
    margin-bottom: 14px;
}

.log-controls .btn-action {
    display: inline-block;
    margin-right: 12px;
    vertical-align: middle;
}

.log-viewport {
    display: block;
    background-color: #07050a;
    border: 1px #1d1628;
    border-radius: 6px;
    padding: 14px 18px;
    height: 480px;
    overflow-y: auto;
}

.log-text {
    font-family: JetBrainsMono NF;
    font-size: 12px;
    color: #b2a8ba;
    white-space: pre-wrap;
    line-height: 1.45;
}

/* Custom Scrollbars */
scrollbarvertical {
    width: 8px;
}

scrollbarvertical slidertrack {
    background-color: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    min-height: 24px;
    background-color: #241b30;
    border-radius: 3px;
}

scrollbarvertical sliderbar:hover {
    background-color: #3e2e52;
}

scrollbarvertical sliderbar:active {
    background-color: #8f1818;
}
