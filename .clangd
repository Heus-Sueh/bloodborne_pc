CompileFlags:
  CompilationDatabase: out/gpu
  Remove:
    - -fprofile-partial-training
    - -fprofile-correction
    - -fprofile-prefix-path=*
    - -Wno-coverage-mismatch
    - -Wno-missing-profile
    - -fno-fat-lto-objects
    - -flto=*

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

---
If:
  PathMatch: ^launcher/.*
CompileFlags:
  CompilationDatabase: out/launcher
  Add:
    - -std=c++20

---
If:
  PathMatch: ^gpu/.*
CompileFlags:
  CompilationDatabase: out/gpu
  Add:
    - -std=c++23

---
If:
  PathMatch: ^(src|tests|tools)/.*\.(c|h)$
CompileFlags:
  Add:
    - -xc
    - -std=c11
    - -D_GNU_SOURCE
    - -Wall
    - -Wextra
    - -I.
    - -Isrc
    - -Ithird_party/LibAtrac9/C/src
